{
  "name": "waveform-3d-analysis",
  "version": "0.1.0",
  "description": "3D 波形分析组件库：基于 Plotly.js 的多通道波形 3D 曲面渲染组件（平滑、降采样、渲染质量、配色、时间切片、视角预设、全屏与图像下载）",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.less"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && pnpm build:lib && pnpm build:types && pnpm build:demo",
    "build:lib": "vite build --config vite.lib.config.ts",
    "build:types": "node scripts/clean-types.mjs && vue-tsc -p tsconfig.lib.json",
    "build:demo": "vite build",
    "preview": "vite preview --outDir dist-demo",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@ant-design/icons-vue": "6.1.0",
    "@vueuse/core": "8.9.4",
    "ant-design-vue": "3.2.20",
    "classnames": "^2.5.1",
    "plotly.js-dist-min": "^3.5.0"
  },
  "peerDependencies": {
    "ant-design-vue": ">=3.2.20 <4",
    "vue": ">=3.2.33 <4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.1",
    "@types/plotly.js": "^3.0.7",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.9.2",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "less": "^4.1.2",
    "prettier": "3.9.5",
    "typescript": "~6.0.0",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "vue": "3.5.40",
    "vue-tsc": "3.3.7"
  }
}
